{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "QStar",
  "scopeName": "source.qstar",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#qstarApi"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#fields"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#luaKeywords"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.qstar",
          "match": "--.*$"
        },
        {
          "name": "comment.block.qstar",
          "begin": "--\\[\\[",
          "end": "\\]\\]"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.qstar",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.qstar",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.qstar",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.qstar",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "entity.name.label.qstar",
          "match": "(@[A-Za-z0-9_.-]+)?//[A-Za-z0-9_./-]*:[A-Za-z0-9_.-]+"
        },
        {
          "name": "entity.name.label.local.qstar",
          "match": ":[A-Za-z0-9_.-]+"
        }
      ]
    },
    "qstarApi": {
      "patterns": [
        {
          "name": "support.function.qstar",
          "match": "\\bqstar\\.(project|profile|config|executable|staticlib|sharedlib|test|custom_target|run_target|group|configure_file|stage|stage_file|target_family|cli|input|output|target_file|subdir|import_file|import_module|files|modules|select|join|copy|append|merge|extend|incompatible)\\b"
        }
      ]
    },
    "fields": {
      "patterns": [
        {
          "name": "variable.parameter.qstar",
          "match": "\\b(name|version|build_dir|generated_dir|compile_commands|configs|sources|deps|public_deps|private_deps|public_headers|private_headers|lang|c|cxx|asm|cale|include_dirs|public_include_dirs|private_include_dirs|system_include_dirs|compile_options|defines|standard|preprocess|profile|modules|enabled|visibility|toolchain|stdlib|libs|lib_dirs|frameworks|link_options|linker_script|defsyms|outputs|inputs|command|timeout|marker|marker_log|output|root|include|exclude)\\b(?=\\s*=)"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.qstar",
          "match": "\\b(QSTAR_VERSION|QSTAR_VERSION_MAJOR|QSTAR_VERSION_MINOR|QSTAR_VERSION_PATCH|QSTAR_HOST_OS|QSTAR_HOST_ARCH|QSTAR_PACKAGE_ROOT|QSTAR_PROJECT_ROOT|QSTAR_PROFILE|QSTAR_TARGET)\\b"
        },
        {
          "name": "constant.language.qstar",
          "match": "\\bqstar\\.(version|host\\.(os|arch)|project\\.root)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.qstar",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "luaKeywords": {
      "patterns": [
        {
          "name": "keyword.control.lua.qstar",
          "match": "\\b(and|break|do|else|elseif|end|false|for|function|if|in|local|nil|not|or|repeat|return|then|true|until|while)\\b"
        }
      ]
    }
  }
}
