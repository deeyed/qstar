{
  "Executable target": {
    "prefix": "qexe",
    "body": [
      "qstar.executable \"${1:app}\" {",
      "  sources = {\"${2:src/main.c}\"},",
      "}"
    ],
    "description": "Create a QStar executable target."
  },
  "Static library target": {
    "prefix": "qstaticlib",
    "body": [
      "qstar.staticlib \"${1:core}\" {",
      "  sources = {\"${2:src/core.c}\"},",
      "  public_headers = {\"${3:include/core.h}\"},",
      "  lang = {",
      "    c = {",
      "      public_include_dirs = {\"${4:include}\"},",
      "    },",
      "  },",
      "}"
    ],
    "description": "Create a QStar static library target."
  },
  "Test target": {
    "prefix": "qtest",
    "body": [
      "qstar.test \"${1:unit}\" {",
      "  sources = {\"${2:tests/unit.c}\"},",
      "  deps = {\"${3://:core}\"},",
      "}"
    ],
    "description": "Create a QStar test target."
  },
  "Generated action": {
    "prefix": "qcustom",
    "body": [
      "qstar.custom_target \"${1:generate}\" {",
      "  inputs = {\"${3:input.txt}\"},",
      "  outputs = {qstar.output(\"${4:generated/output.c}\")},",
      "  command = qstar.cli {\"${2:tools/generate.sh}\", qstar.input(0), qstar.output(0)},",
      "}"
    ],
    "description": "Create a QStar generated action."
  },
  "Config header": {
    "prefix": "qconfig",
    "body": [
      "qstar.configure_file \"${1:config}\" {",
      "  output = qstar.output(\"${2:generated/config.h}\"),",
      "  defines = {\"${3:APP_FEATURE=1}\"},",
      "}"
    ],
    "description": "Create a generated config header."
  },
  "Run target": {
    "prefix": "qrun",
    "body": [
      "qstar.run_target \"${1:smoke}\" {",
      "  deps = {\"${2://:app}\"},",
      "  command = qstar.cli {qstar.target_file(\"${2://:app}\")},",
      "  timeout = ${3:5},",
      "  marker = \"${4:OK}\",",
      "}"
    ],
    "description": "Create an external run target."
  },
  "Subdir fragment": {
    "prefix": "qsubdir",
    "body": [
      "qstar.subdir(\"${1:src}\")"
    ],
    "description": "Include a canonical subdir fragment named <folder>.qs."
  }
}
