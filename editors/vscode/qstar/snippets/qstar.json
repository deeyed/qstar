{
  "Project metadata": {
    "prefix": "qproject",
    "body": [
      "qstar.project {",
      "  name = \"${1:my-project}\",",
      "  version = \"${2:0.1.0}\",",
      "  root = \".\",",
      "  build_dir = \"${3:build/qstar}\",",
      "  generated_dir = \"${4:build/qstar/generated}\",",
      "}"
    ],
    "description": "Declare QStar project metadata."
  },
  "Reusable config": {
    "prefix": "qtargetconfig",
    "body": [
      "qstar.config \"${1:common_c}\" {",
      "  lang = {",
      "    c = {",
      "      public_include_dirs = {\"${2:include}\"},",
      "      compile_options = {\"${3:-Wall}\"},",
      "    },",
      "  },",
      "}"
    ],
    "description": "Declare a reusable target option config."
  },
  "Toolset": {
    "prefix": "qtoolset",
    "body": [
      "qstar.toolset \"${1:host}\" {",
      "  tools = {",
      "    c = { compiler = qstar.cli {\"${2:cc}\"} },",
      "    cxx = { compiler = qstar.cli {\"${3:c++}\"} },",
      "    asm = { compiler = qstar.cli {\"${4:cc}\"} },",
      "    archive = qstar.cli {\"${5:ar}\"},",
      "    link = qstar.cli {\"${6:cc}\"},",
      "  },",
      "  response_files = \"${7:auto}\",",
      "}"
    ],
    "description": "Declare an explicit QStar tool role bundle."
  },
  "Executable target": {
    "prefix": "qexe",
    "body": [
      "qstar.executable \"${1:app}\" {",
      "  sources = {\"${2:src/main.c}\"},",
      "}"
    ],
    "description": "Create a QStar executable target."
  },
  "Static library target": {
    "prefix": "qstaticlib",
    "body": [
      "qstar.staticlib \"${1:core}\" {",
      "  sources = {\"${2:src/core.c}\"},",
      "  lang = {",
      "    c = {",
      "      public_headers = {\"${3:include/core.h}\"},",
      "      public_include_dirs = {\"${4:include}\"},",
      "    },",
      "  },",
      "}"
    ],
    "description": "Create a QStar static library target."
  },
  "Interface dependency": {
    "prefix": "qinterface",
    "body": [
      "qstar.interface \"${1:api_contract}\" {",
      "  compile_usage = {",
      "    options = {\"${2:-DAPI_LEVEL=1}\"},",
      "    inputs = {\"${3:contracts/api.txt}\"},",
      "  },",
      "}"
    ],
    "description": "Declare an artifact-free typed dependency with explicit usage requirements."
  },
  "Imported artifact dependency": {
    "prefix": "qimported",
    "body": [
      "qstar.imported \"${1:vendor}\" {",
      "  artifact_kind = \"${2:prebuilt}\",",
      "  artifacts = {",
      "    default = {",
      "      { id = \"${3:archive}\", role = \"link\", path = \"${4:vendor/libvendor.a}\", primary = true },",
      "    },",
      "  },",
      "}"
    ],
    "description": "Declare platform-selected package-local prebuilt artifacts without flag inference."
  },
  "Executable tool dependency": {
    "prefix": "qtool",
    "body": [
      "qstar.tool \"${1:generator}\" {",
      "  path = \"${2:tools/generator}\",",
      "}"
    ],
    "description": "Declare a package-local executable path consumed with qstar.tool_file."
  },
  "Test target": {
    "prefix": "qtest",
    "body": [
      "qstar.test \"${1:unit}\" {",
      "  sources = {\"${2:tests/unit.c}\"},",
      "  deps = {\"${3://:core}\"},",
      "}"
    ],
    "description": "Create a QStar test target."
  },
  "Generated action": {
    "prefix": "qcustom",
    "body": [
      "qstar.custom_target \"${1:generate}\" {",
      "  inputs = {\"${3:input.txt}\"},",
      "  outputs = {qstar.output(\"${4:build/qstar/generated/output.c}\")},",
      "  command = qstar.cli {\"${2:tools/generate.sh}\", qstar.input(0), qstar.output(0)},",
      "  description = qstar.status(\"${5:Generating output.c}\"),",
      "}"
    ],
    "description": "Create a QStar generated action."
  },
  "Artifact transform": {
    "prefix": "qtransform",
    "body": [
      "qstar.transform \"${1:artifact}\" {",
      "  input = ${2:\"fixtures/input.artifact\"},",
      "  output = qstar.output(\"${3:generated/artifacts/output.artifact}\"),",
      "  command = qstar.cli {\"${4:tools/transform.sh}\", qstar.input(0), qstar.output(0)},",
      "  description = qstar.status(\"${5:Transforming artifact}\"),",
      "}"
    ],
    "description": "Create a single-input single-output generated artifact transform."
  },
  "Config header": {
    "prefix": "qconfig",
    "body": [
      "qstar.configure_file \"${1:config}\" {",
      "  output = qstar.output(\"${2:build/qstar/generated/config.h}\"),",
      "  defines = {\"${3:APP_FEATURE=1}\"},",
      "  description = qstar.status(\"${4:Configuring config.h}\"),",
      "}"
    ],
    "description": "Create a generated config header."
  },
  "Run target": {
    "prefix": "qrun",
    "body": [
      "qstar.run_target \"${1:smoke}\" {",
      "  inputs = {",
      "    qstar.target_file(\"${2://:artifact}\"),",
      "  },",
      "  command = qstar.cli {\"${3:tools/smoke.sh}\", qstar.input(0)},",
      "  timeout = ${4:5},",
      "  expect = {",
      "    contains = \"${5:OK}\",",
      "    file = \"${6:smoke.log}\",",
      "  },",
      "  description = qstar.status(\"${7:Running smoke target}\"),",
      "}"
    ],
    "description": "Create an external run target with first-class inputs."
  },
  "Group target": {
    "prefix": "qgroup",
    "body": [
      "qstar.group \"${1:all}\" {",
      "  deps = {",
      "    \"${2://:core}\",",
      "  },",
      "}"
    ],
    "description": "Create a deps-only aggregate target."
  },
  "Stage package": {
    "prefix": "qstage",
    "body": [
      "qstar.stage \"${1:bundle}\" {",
      "  root = \"${2:stage/bundle}\",",
      "  description = qstar.status(\"${5:Staging package}\"),",
      "  files = {",
      "    qstar.stage_file(qstar.target_file(\"${3://:app}\"), \"${4:bin/app}\"),",
      "  },",
      "}"
    ],
    "description": "Create a copy-only package staging rule."
  },
  "Project command workflow": {
    "prefix": "qcommandworkflow",
    "body": [
      "qstar.command \"${1:workflow}\" {",
      "  description = qstar.status(\"${2:Run workflow}\"),",
      "  options = {",
      "    out = qstar.param.path { default = \"${3:exports/workflow}\" },",
      "    verify = qstar.param.bool { default = true },",
      "  },",
      "  steps = {",
      "    qstar.step.build(\"${4://:artifact}\"),",
      "    qstar.step.stage(\"${5://:layout}\"),",
      "    qstar.step.run {",
      "      when = qstar.param(\"verify\"),",
      "      inputs = {qstar.stage_dir(\"${5://:layout}\")},",
      "      command = qstar.cli {\"${6:tools/check.sh}\", qstar.input(0), qstar.arg_if(qstar.param(\"verify\"), \"--verify\")},",
      "    },",
      "    qstar.step.export_stage(\"${5://:layout}\", {",
      "      to = qstar.param(\"out\"),",
      "    }),",
      "  },",
      "}"
    ],
    "description": "Create a root project command for generic build, check, and layout export workflows."
  },
  "Reusable command specification": {
    "prefix": "qcommandspec",
    "body": [
      "qstar.command_spec \"${1:verify}\" {",
      "  description = qstar.status(\"${2:Verify project}\"),",
      "  aliases = {\"${3:v}\"},",
      "  steps = {",
      "    qstar.step.check(\"${4://...}\"),",
      "  },",
      "}"
    ],
    "description": "Create a pure deeply immutable command specification suitable for a QSM export list."
  },
  "Materialize command set": {
    "prefix": "qcommandset",
    "body": [
      "local commands = qstar.import_module(\"${1:qstar/modules/commands}\")",
      "qstar.command_set(commands)"
    ],
    "description": "Materialize reusable command specifications from root qstar.lua."
  },
  "Status description": {
    "prefix": "qstatus",
    "body": [
      "qstar.status(\"${1:Generating output}\")"
    ],
    "description": "Create a validated one-line QStar status for CMake-style progress and replay logs."
  },
  "Description field": {
    "prefix": "qdesc",
    "body": [
      "description = qstar.status(\"${1:Generating output}\"),"
    ],
    "description": "Add a QStar description field used by progress, Ninja lowering, action-log, replay, and last-failure."
  },
  "Subdir fragment": {
    "prefix": "qsubdir",
    "body": [
      "qstar.subdir(\"${1:src}\")"
    ],
    "description": "Include a canonical subdir fragment named <folder>.qst."
  },
  "Import file": {
    "prefix": "qimportfile",
    "body": [
      "qstar.import_file(\"${1:qstar/policies/common.qst}\")"
    ],
    "description": "Import a package-relative .qst graph fragment."
  },
  "Import module": {
    "prefix": "qimportmodule",
    "body": [
      "local ${1:mod} = qstar.import_module(\"${2:qstar/modules/common}\")"
    ],
    "description": "Import a package-relative .qsm helper module folder."
  },
  "Use language provider": {
    "prefix": "quselanguage",
    "body": [
      "local ${1:zig} = qstar.use_language(\"${2:zig}\")"
    ],
    "description": "Activate a bundled or project-local language provider."
  },
  "Zig provider static library": {
    "prefix": "qziglib",
    "body": [
      "local zig = qstar.use_language(\"zig\")",
      "",
      "qstar.toolset \"${1:host}\" {",
      "  tools = {",
      "    archive = qstar.cli {\"${2:ar}\"},",
      "    link = qstar.cli {\"${3:cc}\"},",
      "    zig = zig.tools {",
      "      compiler = qstar.cli {\"${4:zig}\"},",
      "    },",
      "  },",
      "}",
      "",
      "qstar.staticlib \"${5:core}\" {",
      "  toolset = \"//:${1:host}\",",
      "  lang = {",
      "    zig = zig.options {",
      "      optimize = \"${6:Debug}\",",
      "    },",
      "  },",
      "  sources = {",
      "    \"${7:src/main.zig}\",",
      "  },",
      "}"
    ],
    "description": "Use the bundled standard Zig provider."
  },
  "CUDA provider executable": {
    "prefix": "qcudaapp",
    "body": [
      "local cuda = qstar.use_language(\"cuda\")",
      "",
      "qstar.toolset \"${1:host}\" {",
      "  tools = {",
      "    archive = qstar.cli {\"${2:ar}\"},",
      "    link = qstar.cli {\"${3:cc}\"},",
      "    cuda = cuda.tools {",
      "      compiler = qstar.cli {\"${4:nvcc}\"},",
      "    },",
      "  },",
      "}",
      "",
      "qstar.config \"${5:cuda_debug}\" {",
      "  toolset = \"//:${1:host}\",",
      "  lang = {",
      "    cuda = cuda.options {",
      "      arch = \"${6:native}\",",
      "      compile_options = {},",
      "    },",
      "  },",
      "}",
      "",
      "qstar.executable \"${7:app}\" {",
      "  configs = {\"//:${5:cuda_debug}\"},",
      "  sources = {",
      "    \"${8:src/main.cu}\",",
      "  },",
      "}"
    ],
    "description": "Use the bundled standard CUDA provider."
  },
  "Language provider manifest": {
    "prefix": "qlanguageprovider",
    "body": [
      "return qstar.language_provider {",
      "  api = \"qstar.lang/1\",",
      "  id = \"${1:zig}\",",
      "  version = \"${2:0.1.0}\",",
      "  namespace = \"${1:zig}\",",
      "  implementation = \"provider.lua\",",
      "  tools = {",
      "    compiler = {role = \"${1:zig}.compiler\", required = true},",
      "  },",
      "  options = {",
      "    target = {",
      "      type = \"string\",",
      "      default = \"native\",",
      "    },",
      "    optimize = {",
      "      type = \"enum\",",
      "      values = {\"Debug\", \"ReleaseSafe\", \"ReleaseFast\", \"ReleaseSmall\"},",
      "      default = \"Debug\",",
      "    },",
      "    compile_options = {",
      "      type = \"list\",",
      "      default = {},",
      "    },",
      "  },",
      "  units = {",
      "    object = {",
      "      suffixes = {\".${1:zig}\"},",
      "      emits = \"object\",",
      "      lower = \"compile_object\",",
      "    },",
      "  },",
      "  exports = {",
      "    tools = \"tools\",",
      "    options = \"options\",",
      "    object = \"object\",",
      "  },",
      "}"
    ],
    "description": "Create a provider manifest for qstar/languages/<id>/<id>.qsm."
  },
  "Module table": {
    "prefix": "qmodule",
    "body": [
      "local M = {}",
      "",
      "function M.${1:helper}(${2})",
      "  return ${3:{}}",
      "end",
      "",
      "return M"
    ],
    "description": "Create a .qsm helper module table."
  }
}
