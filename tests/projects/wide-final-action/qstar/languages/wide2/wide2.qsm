return qstar.language_provider {
  api = "qstar.lang/2",
  id = "wide2",
  version = "2.0",
  namespace = "wide2",
  implementation = "provider.lua",
  tools = {
    compiler = {
      role = "wide2.compiler",
      required = true,
    },
  },
  units = {
    object = {
      suffixes = {".w2"},
      emits = "object",
      lower = "compile_object",
    },
  },
  finals = {
    executable = {
      lower = "link_executable",
      inputs = {
        "sources",
        "objects",
        "link_interfaces",
        "link_inputs",
        "link_options",
      },
      artifacts = {
        runtime = {
          type = "file",
          roles = {"primary", "runtime"},
        },
      },
    },
  },
  exports = {
    tools = "tools",
    options = "options",
    object = "object",
  },
}
